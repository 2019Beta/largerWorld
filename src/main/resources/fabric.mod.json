{
  "schemaVersion": 1,
  "id": "largerworld",
  "version": "${version}",
  "name": "Larger World",
  "description": "A cell-based floating-origin prototype for very large Minecraft coordinates.",
  "authors": ["devt"],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.devt.largerworld.client.LargerworldDataGenerator"
    ],
    "client": [
      "org.devt.largerworld.client.LargerworldClient"
    ],
    "main": [
      "org.devt.largerworld.Largerworld"
    ]
  },
  "mixins": [
    "largerworld.mixins.json",
    {
      "config": "largerworld.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
